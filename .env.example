# CrimeSphere AI Master Environment Template
# Duplicate this file to .env in production deployment

# Database Settings
DB_URL=jdbc:postgresql://localhost:5432/crimesphere_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# Authentication Secrets
JWT_SECRET=your_super_secure_random_256_bit_jwt_secret_key_here

# Groq LLM API Key (FastAPI Microservice)
GROQ_API_KEY=your_groq_api_key_here

# Internal AI Service Secret (Shared between Spring Boot and FastAPI)
AI_SERVICE_API_KEY=crime-sphere-internal-ai-key-2026-prod

# Notification Credentials
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_id

# Public News Intelligence Provider API Key (Phase 14)
NEWS_API_KEY=replace-with-your-key
PUBLIC_SEARCH_MOCK_ENABLED=false

# Supabase Storage Key
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
