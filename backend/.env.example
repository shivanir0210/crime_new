# CrimeSphere Backend Environment Variables Example (Phase 16)
# Copy this file to .env and configure real credentials for production deployment.

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/crimesphere_db
DB_USERNAME=postgres
DB_PASSWORD=Postgres@12345
DB_DRIVER=org.postgresql.Driver

# Security & JWT Token Configuration (HMAC-SHA256)
JWT_SECRET=your_super_secure_random_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Resend Mail API Configuration (Case & Evidence notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Spring Mail SMTP Settings (Login alerts)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=alerts@crimesphere.internal

# Supabase Storage Configuration (Private evidence bucket)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_EVIDENCE_BUCKET=crime-evidence
STORAGE_LOCAL_DIR=./storage/evidence

# FastAPI AI Service Configuration (Internal Microservice)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=crime-sphere-internal-ai-key-2026-prod
AI_SERVICE_TIMEOUT_MS=30000

# WhatsApp Cloud API Configuration (Meta Graph API)
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_API_VERSION=v19.0
WHATSAPP_TEMPLATE_ENABLED=false
WHATSAPP_TEMPLATE_NAME=case_update_alert
WHATSAPP_TEMPLATE_LANGUAGE=en

# Public Search & News Intelligence Settings (Phase 14)
PUBLIC_SEARCH_PROVIDER=newsapi
NEWS_API_KEY=YOUR_REAL_NEWSAPI_KEY_HERE
PUBLIC_SEARCH_BASE_URL=https://newsapi.org/v2
PUBLIC_SEARCH_TIMEOUT_SECONDS=15
PUBLIC_SEARCH_MAX_RESULTS=10
PUBLIC_SEARCH_MOCK_ENABLED=false

# Gemini Image Generation & AI Scene Visualizer Settings (Phase 17)
GEMINI_API_KEY=YOUR_REAL_GEMINI_API_KEY_HERE
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_IMAGE_TIMEOUT_SECONDS=45
GEMINI_IMAGE_MOCK_ENABLED=false

